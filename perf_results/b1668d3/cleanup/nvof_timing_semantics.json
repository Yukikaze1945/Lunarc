  "stage_meaning": {
    "nvof_convert_ms": "not separable: the conversion and the upscale are one fused kernel",
    "nvof_dependency_wait_ms": "waiting for the input frame's producer to finish, timed separately from the execute",
    "nvof_download_ms": "the device to host copy of the flow grid",
    "nvof_gpu_execute_ms": "not separable: the execute and the synchronize that waits for it are one span on this hardware",
    "nvof_postprocess_wait_inclusive_ms": "the S10.5 convert-and-upscale kernel plus the synchronize that waits for it, as one inclusive span",
