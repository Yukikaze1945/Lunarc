# Native build intermediates: the published artifacts are the .dll files plus their
# sources and build scripts. Import libraries and object files are regenerated by
# native/build.bat and native/build_residual.bat.
native/*.obj
native/*.pdb
native/*.lib
native/*.exp
native/*_test.exe
native/*_probe.exe
